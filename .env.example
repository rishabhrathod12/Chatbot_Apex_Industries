# Copy to .env and fill in. Never commit .env.
APP_ENV=development
OPENAI_API_KEY=
JWT_SECRET_KEY=
DATABASE_URL=sqlite:///./storage/app.db
# PostgreSQL instead (put the real password in .env ONLY, never here):
# DATABASE_URL=postgresql://apex:PASSWORD@localhost:5432/apex
# Docker only (docker-compose.yml): the database password, URL-safe characters only.
POSTGRES_PASSWORD=
# First-run "create Super Admin" page. Optional in development; REQUIRED in production for the page
# to work at all. A long random value. Remove it after the first account exists.
SETUP_TOKEN=
VECTOR_STORE_PATH=./vector_db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
MAX_FILES_PER_REQUEST=10
MAX_PDF_PAGES=200
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
EMBEDDING_PROVIDER=openai   # or 'hashing' to run offline without an API key (dev/test only)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
CHAT_MODEL=gpt-4.1-mini
CHAT_MAX_TOKENS=600
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25   # use ~0.40 if you turn reranking off
CHAT_HISTORY_TURNS=3
RETRIEVAL_MODE=hybrid   # or semantic (meaning only)
RETRIEVAL_CANDIDATES=20
RERANK_ENABLED=true
RERANK_TOP_N=8
RERANK_MIN_RELEVANCE=2
# Optional answer-quality settings. The defaults are the measured ones (docs/ragas-evaluation.md).
RETRIEVAL_KEYWORD_RESCUE=0   # 0 = off; N lets the top N keyword matches skip the similarity floor
OVERVIEW_ENABLED=true   # answer "summary of documents" / "key points of document" requests
OVERVIEW_MAX_DOCUMENTS=6
OVERVIEW_MAX_CHARS=36000
OVERVIEW_MAX_ANSWER_TOKENS=3000
